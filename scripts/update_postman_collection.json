// Filter out existing folders if already present, and append
collection.item = collection.item.filter(
  (folder: any) =>
    folder.name !== '9. Academic Sessions & Preferences' &&
    folder.name !== '10. Dashboard & Analytics Widgets'
);

collection.item.push(sessionFolder);
collection.item.push(dashboardFolder);

fs.writeFileSync(collectionPath, JSON.stringify(collection, null, 2), 'utf8');

const totalRequests = collection.item.reduce(
  (acc: number, f: any) => acc + (f.item ? f.item.length : 1),
  0
);
console.log(`✅ Successfully updated Postman Collection! Total folders: ${collection.item.length}, Total requests: ${totalRequests}`);

