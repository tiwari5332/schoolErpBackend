import fs from 'fs';
import path from 'path';

const collectionPath = path.join(__dirname, '..', 'School_ERP.postman_collection.json');
const collection = JSON.parse(fs.readFileSync(collectionPath, 'utf8'));

// 1. Ensure collection variables
const varKeys = new Set(collection.variable.map((v: any) => v.key));
if (!varKeys.has('sessionId')) {
  collection.variable.push({
    key: 'sessionId',
    value: '',
    type: 'string',
  });
}
if (!varKeys.has('superAdminToken')) {
  collection.variable.push({
    key: 'superAdminToken',
    value: '',
    type: 'string',
  });
}

