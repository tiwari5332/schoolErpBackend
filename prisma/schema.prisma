generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id               String                      @id @default(uuid()) @db.Uuid
  name             String                      @db.VarChar(255)
  address          String?
  contactEmail     String                      @db.VarChar(255)
  contactPhone     String                      @db.VarChar(50)
  status           String                      @default("ACTIVE") @db.VarChar(50)
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  schoolId         String?                     @unique @db.VarChar(20)
  academicYears    AcademicYear[]
  admins           Admin[]
  broadcasts       Broadcast[]
  discountPolicies BulkPaymentDiscountPolicy[]
  departments      Department[]
  feeComponents    FeeComponent[]
  grades           Grade[]
  lateFeeSlabs     LateFeeSlab[]
  parentAccounts   ParentAccount[]
  roles            Role[]
  subscriptions    SchoolSubscription[]
  sections         Section[]
  students         Student[]
  subjectTypes     SubjectType[]
  subjects         Subject[]
  teachers         Teacher[]
  topUpPacks       TopUpPack[]
  usageLedgers     UsageLedger[]

  @@map("schools")
}

model Plan {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique @db.VarChar(50)
  displayName   String               @map("display_name") @db.VarChar(100)
  monthlyPrice  Decimal              @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice   Decimal              @map("yearly_price") @db.Decimal(10, 2)
  studentCap    Int                  @map("student_cap")
  teacherCap    Int                  @map("teacher_cap")
  smsQuota      Int                  @map("sms_quota")
  whatsappQuota Int                  @map("whatsapp_quota")
  active        Boolean              @default(true)
  featuresJson  String?              @map("features_json")
  createdAt     DateTime             @default(now()) @map("created_at")
  planFeatures  PlanFeature[]
  subscriptions SchoolSubscription[]

  @@map("plans")
}

model Feature {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(100)
  description  String?
  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id        String  @id @default(uuid()) @db.Uuid
  planId    String  @map("plan_id") @db.Uuid
  featureId String  @map("feature_id") @db.Uuid
  enabled   Boolean @default(true)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("plan_features")
}

model SchoolSubscription {
  id                       String    @id @default(uuid()) @db.Uuid
  schoolId                 String    @map("school_id") @db.Uuid
  planId                   String    @map("plan_id") @db.Uuid
  billingCycle             String    @map("billing_cycle") @db.VarChar(20)
  startDate                DateTime  @map("start_date")
  endDate                  DateTime? @map("end_date")
  status                   String    @default("ACTIVE") @db.VarChar(50)
  overrideMaxStudents      Int?      @map("override_max_students")
  overrideMaxTeachers      Int?      @map("override_max_teachers")
  overriddenBySuperAdminId String?   @map("overridden_by_super_admin_id") @db.Uuid
  overrideReason           String?   @map("override_reason")
  changeReason             String?   @map("change_reason")
  createdAt                DateTime  @default(now()) @map("created_at")
  plan                     Plan      @relation(fields: [planId], references: [id])
  school                   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_subscriptions")
}

model TopUpPack {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  channel          String   @db.VarChar(20)
  creditsPurchased Int      @map("credits_purchased")
  costPaid         Decimal  @map("cost_paid") @db.Decimal(10, 2)
  purchasedAt      DateTime @default(now()) @map("purchased_at")
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("top_up_packs")
}

model UsageLedger {
  id               String @id @default(uuid()) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  channel          String @db.VarChar(20)
  yearMonth        String @map("year_month") @db.VarChar(7)
  planCreditsUsed  Int    @default(0) @map("plan_credits_used")
  topUpCreditsUsed Int    @default(0) @map("top_up_credits_used")
  school           School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, channel, yearMonth])
  @@map("usage_ledgers")
}

model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("super_admins")
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  msisdn       String   @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Teacher {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolId           String                  @map("school_id") @db.Uuid
  employeeCode       String                  @map("employee_code") @db.VarChar(100)
  name               String                  @db.VarChar(255)
  email              String?                 @db.VarChar(255)
  loginMsisdn        String                  @map("login_msisdn") @db.VarChar(50)
  msisdns            String?
  dob                DateTime?
  gender             String?                 @db.VarChar(20)
  address            String?
  aadharNo           String?                 @map("aadhar_no") @db.VarChar(50)
  panNo              String?                 @map("pan_no") @db.VarChar(50)
  bankDetails        String?                 @map("bank_details")
  dateOfJoining      DateTime?               @map("date_of_joining")
  designation        String?                 @db.VarChar(100)
  passwordHash       String?                 @map("password_hash") @db.VarChar(255)
  passwordSet        Boolean                 @default(false) @map("password_set")
  status             String                  @default("ACTIVE") @db.VarChar(50)
  createdAt          DateTime                @default(now()) @map("created_at")
  subjectAssignments SectionSubjectTeacher[]
  classSections      Section[]               @relation("ClassTeacher")
  broadcastQuotas    TeacherBroadcastQuota[]
  departmentMaps     TeacherDepartmentMap[]
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeCode])
  @@map("teachers")
}

model ParentAccount {
  id           String     @id @default(uuid()) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  msisdn       String     @db.VarChar(50)
  name         String     @db.VarChar(255)
  email        String?    @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  passwordSet  Boolean    @default(false) @map("password_set")
  status       String     @default("ACTIVE") @db.VarChar(50)
  createdAt    DateTime   @default(now()) @map("created_at")
  guardians    Guardian[]
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, msisdn])
  @@map("parent_accounts")
}

model Guardian {
  id              String        @id @default(uuid()) @db.Uuid
  parentAccountId String        @map("parent_account_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  relation        String        @db.VarChar(50)
  occupation      String?       @db.VarChar(100)
  address         String?
  isPrimary       Boolean       @default(false) @map("is_primary")
  parentAccount   ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentAccountId, studentId])
  @@map("guardians")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  actorType String   @map("actor_type") @db.VarChar(50)
  actorId   String   @map("actor_id") @db.Uuid
  deviceId  String?  @map("device_id") @db.VarChar(255)
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_sessions")
}

model OtpRequest {
  id         String    @id @default(uuid()) @db.Uuid
  msisdn     String    @db.VarChar(50)
  otpHash    String    @map("otp_hash") @db.VarChar(255)
  purpose    String    @db.VarChar(50)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("otp_requests")
}

model Department {
  id           String                 @id @default(uuid()) @db.Uuid
  schoolId     String                 @map("school_id") @db.Uuid
  name         String                 @db.VarChar(255)
  code         String                 @db.VarChar(50)
  hodTeacherId String?                @map("hod_teacher_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  facultyMaps  TeacherDepartmentMap[]

  @@unique([schoolId, code])
  @@map("departments")
}

model TeacherDepartmentMap {
  id             String     @id @default(uuid()) @db.Uuid
  teacherId      String     @map("teacher_id") @db.Uuid
  departmentId   String     @map("department_id") @db.Uuid
  academicYearId String     @map("academic_year_id") @db.Uuid
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacher        Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, departmentId, academicYearId])
  @@map("teacher_department_maps")
}

model Role {
  id               String                @id @default(uuid()) @db.Uuid
  schoolId         String?               @map("school_id") @db.Uuid
  name             String                @db.VarChar(100)
  description      String?
  createdAt        DateTime              @default(now()) @map("created_at")
  actorAssignments ActorRoleAssignment[]
  rolePermissions  RolePermission[]
  school           School?               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model ActorRoleAssignment {
  id        String @id @default(uuid()) @db.Uuid
  actorType String @map("actor_type") @db.VarChar(50)
  actorId   String @map("actor_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([actorType, actorId, roleId])
  @@map("actor_role_assignments")
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String    @db.VarChar(100)
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  status    String    @default("ACTIVE") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections  Section[]

  @@map("academic_years")
}

model Grade {
  id               String                      @id @default(uuid()) @db.Uuid
  schoolId         String                      @map("school_id") @db.Uuid
  name             String                      @db.VarChar(100)
  sequenceOrder    Int                         @map("sequence_order")
  createdAt        DateTime                    @default(now()) @map("created_at")
  discountPolicies BulkPaymentDiscountPolicy[]
  school           School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections         Section[]

  @@unique([schoolId, name])
  @@map("grades")
}

model Section {
  id                   String                  @id @default(uuid()) @db.Uuid
  schoolId             String                  @map("school_id") @db.Uuid
  gradeId              String                  @map("grade_id") @db.Uuid
  academicYearId       String                  @map("academic_year_id") @db.Uuid
  name                 String                  @db.VarChar(100)
  classTeacherId       String?                 @map("class_teacher_id") @db.Uuid
  capacity             Int                     @default(40)
  enrollments          Enrollment[]
  sectionFeeStructures SectionFeeStructure[]
  subjectMaps          SectionSubjectMap[]
  subjectTeachers      SectionSubjectTeacher[]
  academicYear         AcademicYear            @relation(fields: [academicYearId], references: [id])
  classTeacher         Teacher?                @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  grade                Grade                   @relation(fields: [gradeId], references: [id])
  school               School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, academicYearId, name])
  @@map("sections")
}

model SubjectType {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  name        String    @db.VarChar(100)
  code        String    @db.VarChar(50)
  description String?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects    Subject[]

  @@unique([schoolId, code])
  @@map("subject_types")
}

model Subject {
  id              String                  @id @default(uuid()) @db.Uuid
  schoolId        String                  @map("school_id") @db.Uuid
  name            String                  @db.VarChar(255)
  code            String                  @db.VarChar(50)
  subjectTypeId   String                  @map("subject_type_id") @db.Uuid
  sectionMaps     SectionSubjectMap[]
  subjectTeachers SectionSubjectTeacher[]
  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectType     SubjectType             @relation(fields: [subjectTypeId], references: [id])

  @@unique([schoolId, code])
  @@map("subjects")
}

model SectionSubjectMap {
  id        String  @id @default(uuid()) @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@map("section_subject_maps")
}

model SectionSubjectTeacher {
  id        String  @id @default(uuid()) @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId, teacherId])
  @@map("section_subject_teachers")
}

model TeacherBroadcastQuota {
  id         String  @id @default(uuid()) @db.Uuid
  teacherId  String  @map("teacher_id") @db.Uuid
  channel    String  @db.VarChar(20)
  quotaLimit Int     @map("quota_limit")
  quotaUsed  Int     @default(0) @map("quota_used")
  yearMonth  String  @map("year_month") @db.VarChar(7)
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, channel, yearMonth])
  @@map("teacher_broadcast_quotas")
}

model Student {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  studentCode     String       @map("student_code") @db.VarChar(100)
  name            String       @db.VarChar(255)
  email           String?      @db.VarChar(255)
  phone           String?      @db.VarChar(50)
  dob             DateTime?
  address         String?
  aadharNo        String?      @map("aadhar_no") @db.VarChar(50)
  bloodGroup      String?      @map("blood_group") @db.VarChar(10)
  dateOfAdmission DateTime?    @map("date_of_admission")
  previousSchool  String?      @map("previous_school")
  createdAt       DateTime     @default(now()) @map("created_at")
  enrollments     Enrollment[]
  invoices        FeeInvoice[]
  guardians       Guardian[]
  payments        Payment[]
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentCode])
  @@map("students")
}

model Enrollment {
  id         String       @id @default(uuid()) @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  sectionId  String       @map("section_id") @db.Uuid
  rollNo     Int?         @map("roll_no")
  enrolledAt DateTime     @default(now()) @map("enrolled_at")
  status     String       @default("ACTIVE") @db.VarChar(50)
  section    Section      @relation(fields: [sectionId], references: [id])
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoices   FeeInvoice[]

  @@map("enrollments")
}

model FeeComponent {
  id            String                @id @default(uuid()) @db.Uuid
  schoolId      String                @map("school_id") @db.Uuid
  name          String                @db.VarChar(255)
  code          String                @db.VarChar(50)
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceLines  FeeInvoiceLine[]
  feeStructures SectionFeeStructure[]

  @@unique([schoolId, code])
  @@map("fee_components")
}

model SectionFeeStructure {
  id             String       @id @default(uuid()) @db.Uuid
  sectionId      String       @map("section_id") @db.Uuid
  feeComponentId String       @map("fee_component_id") @db.Uuid
  amount         Decimal      @db.Decimal(10, 2)
  frequency      String       @db.VarChar(50)
  feeComponent   FeeComponent @relation(fields: [feeComponentId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, feeComponentId])
  @@map("section_fee_structures")
}

model LateFeeSlab {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  daysOverdueFrom Int       @map("days_overdue_from")
  daysOverdueTo   Int       @map("days_overdue_to")
  amount          Decimal   @db.Decimal(10, 2)
  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("late_fee_slabs")
}

model BulkPaymentDiscountPolicy {
  id                 String    @id @default(uuid()) @db.Uuid
  schoolId           String    @map("school_id") @db.Uuid
  gradeId            String?   @map("grade_id") @db.Uuid
  monthsCount        Int       @map("months_count")
  discountPercentage Decimal   @map("discount_percentage") @db.Decimal(5, 2)
  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  grade              Grade?    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("bulk_payment_discount_policies")
}

model FeeInvoice {
  id             String              @id @default(uuid()) @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  enrollmentId   String              @map("enrollment_id") @db.Uuid
  yearMonth      String              @map("year_month") @db.VarChar(7)
  dueDate        DateTime            @map("due_date")
  totalAmount    Decimal             @map("total_amount") @db.Decimal(10, 2)
  lateFeeAmount  Decimal             @default(0.00) @map("late_fee_amount") @db.Decimal(10, 2)
  discountAmount Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  paidAmount     Decimal             @default(0.00) @map("paid_amount") @db.Decimal(10, 2)
  balance        Decimal             @db.Decimal(10, 2)
  status         String              @default("PENDING") @db.VarChar(50)
  createdAt      DateTime            @default(now()) @map("created_at")
  lines          FeeInvoiceLine[]
  enrollment     Enrollment          @relation(fields: [enrollmentId], references: [id])
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  waiverLogs     FeeWaiverLog[]
  allocations    PaymentAllocation[]

  @@unique([studentId, yearMonth])
  @@map("fee_invoices")
}

model FeeInvoiceLine {
  id             String       @id @default(uuid()) @db.Uuid
  feeInvoiceId   String       @map("fee_invoice_id") @db.Uuid
  feeComponentId String       @map("fee_component_id") @db.Uuid
  amount         Decimal      @db.Decimal(10, 2)
  feeComponent   FeeComponent @relation(fields: [feeComponentId], references: [id])
  feeInvoice     FeeInvoice   @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)

  @@map("fee_invoice_lines")
}

model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  studentId         String              @map("student_id") @db.Uuid
  amount            Decimal             @db.Decimal(10, 2)
  mode              String              @db.VarChar(50)
  gatewayTxnId      String?             @unique @map("gateway_txn_id") @db.VarChar(255)
  paidByGuardianId  String?             @map("paid_by_guardian_id") @db.Uuid
  recordedByAdminId String?             @map("recorded_by_admin_id") @db.Uuid
  paidAt            DateTime            @default(now()) @map("paid_at")
  status            String              @default("SUCCESS") @db.VarChar(50)
  allocations       PaymentAllocation[]
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@map("payments")
}

model PaymentAllocation {
  id           String     @id @default(uuid()) @db.Uuid
  paymentId    String     @map("payment_id") @db.Uuid
  feeInvoiceId String     @map("fee_invoice_id") @db.Uuid
  amount       Decimal    @db.Decimal(10, 2)
  feeInvoice   FeeInvoice @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_allocations")
}

model FeeWaiverLog {
  id              String     @id @default(uuid()) @db.Uuid
  feeInvoiceId    String     @map("fee_invoice_id") @db.Uuid
  waivedByAdminId String     @map("waived_by_admin_id") @db.Uuid
  originalLateFee Decimal    @map("original_late_fee") @db.Decimal(10, 2)
  reason          String
  waivedAt        DateTime   @default(now()) @map("waived_at")
  feeInvoice      FeeInvoice @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)

  @@map("fee_waiver_logs")
}

model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  mode              String   @db.VarChar(50)
  reason            String
  approvedByAdminId String   @map("approved_by_admin_id") @db.Uuid
  processedAt       DateTime @default(now()) @map("processed_at")
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Broadcast {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  senderTeacherId String?   @map("sender_teacher_id") @db.Uuid
  channel         String    @db.VarChar(20)
  messageBody     String    @map("message_body")
  recipientCount  Int       @map("recipient_count")
  scheduledAt     DateTime? @map("scheduled_at")
  sentAt          DateTime? @map("sent_at")
  status          String    @default("PENDING") @db.VarChar(50)
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("broadcasts")
}

model MessageTemplate {
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(100)
  code     String @unique @db.VarChar(50)
  template String
  channel  String @db.VarChar(20)

  @@map("message_templates")
}

model employeeEmployment {
  id                String @id @default(uuid()) @db.Uuid
  school_id         String? @db.VarChar(20)
  employee_id       String? @db.VarChar(20)
  department_id     String? @db.VarChar(20)
  designation       String? @db.VarChar(20)
  employeement_type String? @db.VarChar(20)
  joining_Date      String? @db.VarChar(20)
  status            String?

  @@map("employee_employment")
}
