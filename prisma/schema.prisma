// ==========================================
// EduTrio Multi-Tenant SaaS Models (Phase B1+)
// ==========================================

model Tenant {
  id                  String               @id @map("id") @db.VarChar(64)
  name                String               @db.VarChar(255)
  slug                String               @unique @db.VarChar(100)
  logoUrl             String?              @map("logo_url")
  brandColor          String               @default("#4F46E5") @map("brand_color") @db.VarChar(50)
  board               String               @default("CBSE") @db.VarChar(50)
  udiseCode           String?              @map("udise_code") @db.VarChar(50)
  address             Json?
  phone               String?              @db.VarChar(50)
  email               String               @db.VarChar(255)
  timezone            String               @default("Asia/Kolkata") @db.VarChar(50)
  currency            String               @default("INR") @db.VarChar(10)
  status              String               @default("TRIAL") @db.VarChar(50)
  onboardingDismissed Boolean              @default(false) @map("onboarding_dismissed")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  users               User[]
  roles               TenantRole[]
  subscriptions       Subscription[]
  invoices            SubscriptionInvoice[]
  paymentOrders       PaymentOrder[]
  invites             UserInvite[]
  auditLogs           AuditLog[]

  @@map("tenants")
}

model SaasPlan {
  id           String         @id @map("id") @db.VarChar(64)
  code         String         @unique @db.VarChar(50)
  name         String         @db.VarChar(100)
  description  String?
  priceMonthly Decimal        @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal        @map("price_yearly") @db.Decimal(10, 2)
  currency     String         @default("INR") @db.VarChar(10)
  trialDays    Int            @default(14) @map("trial_days")
  limits       Json           @default("{}")
  features     Json           @default("[]")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("saas_plans")
}

model Subscription {
  id                 String               @id @map("id") @db.VarChar(64)
  tenantId           String               @map("tenant_id") @db.VarChar(64)
  planId             String               @map("plan_id") @db.VarChar(64)
  planName           String               @map("plan_name") @db.VarChar(100)
  status             String               @default("TRIAL") @db.VarChar(50)
  billingCycle       String               @default("YEARLY") @map("billing_cycle") @db.VarChar(20)
  trialEndsAt        DateTime?            @map("trial_ends_at")
  currentPeriodStart DateTime             @map("current_period_start")
  currentPeriodEnd   DateTime             @map("current_period_end")
  autoRenew          Boolean              @default(true) @map("auto_renew")
  usage              Json                 @default("{}")
  limits             Json                 @default("{}")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SaasPlan             @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id           String   @id @map("id") @db.VarChar(64)
  tenantId     String   @map("tenant_id") @db.VarChar(64)
  number       String   @unique @db.VarChar(100)
  planId       String   @map("plan_id") @db.VarChar(64)
  planName     String   @map("plan_name") @db.VarChar(100)
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("INR") @db.VarChar(10)
  status       String   @default("PAID") @db.VarChar(50)
  billingCycle String   @map("billing_cycle") @db.VarChar(20)
  issuedAt     DateTime @default(now()) @map("issued_at")
  pdfUrl       String?  @map("pdf_url")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscription_invoices")
}

model PaymentOrder {
  id           String   @id @map("id") @db.VarChar(64)
  tenantId     String   @map("tenant_id") @db.VarChar(64)
  orderId      String   @unique @map("order_id") @db.VarChar(100)
  gateway      String   @default("RAZORPAY") @db.VarChar(50)
  planId       String   @map("plan_id") @db.VarChar(64)
  billingCycle String   @map("billing_cycle") @db.VarChar(20)
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("INR") @db.VarChar(10)
  status       String   @default("CREATED") @db.VarChar(50)
  paymentId    String?  @map("payment_id") @db.VarChar(100)
  signature    String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payment_orders")
}

model TenantRole {
  id          String   @id @map("id") @db.VarChar(64)
  tenantId    String?  @map("tenant_id") @db.VarChar(64)
  key         String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_roles")
}

model User {
  id                 String          @id @map("id") @db.VarChar(64)
  tenantId           String?         @map("tenant_id") @db.VarChar(64)
  name               String          @db.VarChar(255)
  email              String          @db.VarChar(255)
  phone              String?         @db.VarChar(50)
  passwordHash       String          @map("password_hash") @db.VarChar(255)
  avatarUrl          String?         @map("avatar_url")
  roleId             String          @map("role_id") @db.VarChar(64)
  roleKey            String          @default("ADMIN") @map("role_key") @db.VarChar(50)
  roleName           String          @default("Admin") @map("role_name") @db.VarChar(100)
  status             String          @default("ACTIVE") @db.VarChar(50)
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  linkedStaffId      String?         @map("linked_staff_id") @db.VarChar(64)
  linkedStudentIds   Json            @default("[]") @map("linked_student_ids")
  lastLoginAt        DateTime?       @map("last_login_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  tenant             Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role               TenantRole      @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @map("id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  familyId  String   @map("family_id") @db.VarChar(64)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @map("id") @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model UserInvite {
  id         String    @id @map("id") @db.VarChar(64)
  tenantId   String    @map("tenant_id") @db.VarChar(64)
  email      String    @db.VarChar(255)
  name       String    @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  roleId     String    @map("role_id") @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("user_invites")
}

model AuditLog {
  id         String   @id @map("id") @db.VarChar(64)
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     String?  @map("user_id") @db.VarChar(64)
  userName   String?  @map("user_name") @db.VarChar(255)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  changes    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("audit_logs")
}


